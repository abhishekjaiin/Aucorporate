# AU Corporate Content & SEO Dashboard — Phase 1
# PostgreSQL + Drizzle + Auth.js

# Standard Postgres connection string. In production, point this at your
# chosen provider (Vercel Postgres/Neon, Supabase, RDS, etc.) — any
# standard Postgres connection string works unchanged.
DATABASE_URL=postgresql://user:password@host:5432/database

# Auth.js session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Base URL of the deployed app (used by Auth.js for callback URLs).
NEXTAUTH_URL=https://www.theaucorp.com
